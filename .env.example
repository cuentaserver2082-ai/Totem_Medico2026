# Copie este archivo a ".env" y complete los valores. NUNCA suba ".env" a git.

# --- IA (opcional: sin clave el tótem usa preguntas y reglas locales) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Acceso del médico al portal (/doctor) ---
DOCTOR_EMAIL=marcos.gonzalez@salud.cl
DOCTOR_PASSWORD=cambie-esta-clave
DOCTOR_NOMBRE=Dr. Marcos González

# Poner 1 cuando el sistema se sirva por HTTPS (la cookie de sesión viaja solo cifrada)
COOKIE_SECURE=0

# --- Modo demostración (para presentar rápido) ---
# MODO_DEMO=1  -> botón "Entrar como médico de demostración" en /doctor (sin clave)
# RUT_ESTRICTO=0 -> el tótem acepta cualquier RUT con formato válido, aunque sea inventado
# Para uso real: MODO_DEMO=0 y RUT_ESTRICTO=1
MODO_DEMO=1
RUT_ESTRICTO=0
